#!/usr/bin/env python3
"""Persistent assistant orb for the kiosk desktop.

Floats bottom-left (above the volume badge) above ALL windows — kiosk page,
streaming sessions, VLC. It is THE assistant control:
  - blue:    idle (fades out after ~3s without pointer movement, like the
             other badges)
  - amber:   connecting
  - green:   live (pulsing; stays fully visible)
  - red:     error (click retries)
Click toggles the assistant session on/off.

State travels through http://localhost/api/assistant-ctl.php: the badge
polls the page's state and posts toggle commands; the web page
(assistant.js) polls the same endpoint for commands.

Install at /usr/local/bin/kiosk-orb, autostart at login (kiosk-orb.desktop).
"""
import json
import math
import subprocess
import threading
import tkinter as tk
import urllib.request

CTL = 'http://localhost/api/assistant-ctl.php'
COLD_SIZE = 64
HOT_SIZE = 128   # orb doubles up while the session is hot
# The badge keeps one fixed center point (above the volume badge) and
# grows/shrinks around it.
CENTER = (40 + COLD_SIZE // 2, (1080 - 420) + COLD_SIZE // 2)
COLORS = {
    'idle': '#5f9cf0',
    'connecting': '#f0b45f',
    'live': '#43d17c',
    'error': '#d16a5f',
}

state = {'state': 'idle', 'size': COLD_SIZE, 'pos': None,
         'idle': 0, 'alpha': 1.0, 'phase': 0.0}


def http(payload=None):
    try:
        if payload is None:
            with urllib.request.urlopen(CTL, timeout=1.5) as r:
                return json.loads(r.read())
        req = urllib.request.Request(
            CTL, data=json.dumps(payload).encode(),
            headers={'Content-Type': 'application/json'}, method='POST')
        with urllib.request.urlopen(req, timeout=1.5) as r:
            return json.loads(r.read())
    except Exception:
        return None


def post_toggle():
    # HTTP off the Tk thread so a slow Apache never freezes the badge.
    threading.Thread(target=http, args=({'command': 'toggle'},),
                     daemon=True).start()


root = tk.Tk()
root.title("Assistant")
root.overrideredirect(True)
root.attributes('-topmost', True)
root.configure(bg='#0b0e13')

cv = tk.Canvas(root, width=COLD_SIZE, height=COLD_SIZE,
               bg='#0b0e13', highlightthickness=0)
cv.pack()
glow = cv.create_oval(0, 0, 0, 0, fill='#1c2635', width=0)
orb = cv.create_oval(0, 0, 0, 0, fill=COLORS['idle'], width=0)


def apply_size():
    s = state['size']
    root.geometry(f'{s}x{s}+{CENTER[0] - s // 2}+{CENTER[1] - s // 2}')
    cv.config(width=s, height=s)


apply_size()

cv.bind('<ButtonRelease-1>', lambda _: post_toggle())


def draw():
    st = state['state']
    color = COLORS.get(st, COLORS['idle'])
    s = state['size']
    cx = cy = s / 2
    hot = st in ('live', 'connecting')
    if st == 'live':
        r = s * 0.31 + s * 0.09 * math.sin(state['phase'] * 3.2)
    elif st == 'connecting':
        r = s * 0.28 + s * 0.05 * math.sin(state['phase'] * 3.2)
    else:
        r = s * 0.31
    cv.coords(orb, cx - r, cy - r, cx + r, cy + r)
    # Hot must be plainly visible from the couch: bright core, light ring,
    # and a dark contrast disc behind it so it pops on any background.
    cv.itemconfig(orb, fill=color,
                  outline='#eafff0' if hot else '',
                  width=3 if hot else 0)
    gr = s / 2 - 2 if hot else min(s / 2 - 2, r + s * 0.12)
    cv.coords(glow, cx - gr, cy - gr, cx + gr, cy + gr)
    cv.itemconfig(glow, fill='#101826' if hot else '#1c2635')


def pointer():
    try:
        out = subprocess.run(['xdotool', 'getmouselocation'],
                             capture_output=True, text=True, timeout=2)
        return out.stdout.strip()
    except Exception:
        return ''


state['pos'] = pointer()


def poll_state():
    res = http()
    if res and res.get('state') in COLORS:
        state['state'] = res['state']
    root.after(500, poll_state)


def tick():
    state['phase'] += 0.12

    # Hot (live/connecting) doubles the orb; cold shrinks it back. The orb
    # only ever fades while cold — never mid-session.
    want = HOT_SIZE if state['state'] in ('live', 'connecting') else COLD_SIZE
    if want != state['size']:
        state['size'] = want
        apply_size()

    p = pointer()
    if p != state['pos']:
        state['pos'] = p
        state['idle'] = 0
        if state['alpha'] < 1.0:
            state['alpha'] = min(1.0, state['alpha'] + 0.34)
            root.attributes('-alpha', state['alpha'])
    else:
        state['idle'] += 1

    # Only the inactive orb fades (with the other badges, ~3s); live or
    # connecting states stay fully visible so the mic state is obvious.
    if state['state'] == 'idle' and state['idle'] >= 30 and state['alpha'] > 0.06:
        state['alpha'] = max(0.06, state['alpha'] - 0.05)
        root.attributes('-alpha', state['alpha'])
    elif state['state'] != 'idle' and state['alpha'] < 1.0:
        state['alpha'] = 1.0
        root.attributes('-alpha', 1.0)

    draw()
    root.after(100, tick)


root.after(500, poll_state)
root.after(100, tick)
root.mainloop()
