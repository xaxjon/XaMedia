#!/bin/bash
# Launch a fullscreen streaming browser session on the kiosk display.
# Installed at /usr/local/bin/kiosk-stream, invoked as the kiosk user via:
#   sudo -n -u <kioskuser> /usr/local/bin/kiosk-stream <url>
# A dedicated Chrome profile keeps streaming logins (Netflix etc.) alive.
# A small always-on-top ✕ button is the mouse-only way out; when Chrome
# exits, the kiosk home screen underneath becomes visible again.
#
# URL policy: https anywhere (streaming services + the assistant's
# open_website tool); plain http restricted to LAN hosts.

set -u

# Detach first (the sudoers rule matches this exact path, not setsid).
if [ -z "${KIOSK_STREAM_DETACHED:-}" ]; then
    KIOSK_STREAM_DETACHED=1 setsid nohup "$0" "$@" >/dev/null 2>&1 &
    exit 0
fi

url="${1:-}"
# Streaming services and the assistant's open_website tool: https anywhere;
# plain http only for LAN hosts (camview, local tools).
case "$url" in
    https://*) ;;
    http://192.168.*|http://10.*|http://172.1[6-9].*|http://172.2[0-9].*|http://172.3[0-1].*) ;;
    *) echo "kiosk-stream: url not allowed" >&2; exit 1 ;;
esac

KIOSK_USER=user
export HOME=/home/$KIOSK_USER
export XDG_RUNTIME_DIR=/run/user/$(id -u $KIOSK_USER)
export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
export DISPLAY=:0 XAUTHORITY=$HOME/.Xauthority

PROFILE=$HOME/.xamedia-chrome

# Only one streaming session at a time (and clean up legacy firefox ones).
pkill -f "chrome.*xamedia-chrome" 2>/dev/null
pkill -f "firefox.*xamedia-streaming" 2>/dev/null
# Stale Tk supervisors from previous sessions (they watch any chrome session).
pkill -f "python3 - .*xamedia-" 2>/dev/null
sleep 0.5

setsid nohup google-chrome \
    --user-data-dir="$PROFILE" \
    --kiosk --no-first-run --no-default-browser-check \
    --disable-session-crashed-bubble --hide-crash-restore-bubble --password-store=basic \
    --use-fake-ui-for-media-stream \
    "$url" >/dev/null 2>&1 &

python3 - "$PROFILE" <<'PYEOF'
import subprocess, sys, tkinter as tk

profile = sys.argv[1]

def browser_alive():
    return subprocess.run(['pgrep', '-f', 'chrome.*xamedia-chrome'],
                          stdout=subprocess.DEVNULL).returncode == 0

root = tk.Tk()
root.title("Exit session")
root.overrideredirect(True)
root.attributes('-topmost', True)
root.configure(bg='#0b0e13')
btn = tk.Button(root, text='✕ Exit', font=('sans', 18, 'bold'),
                fg='white', bg='#b3402a', activebackground='#d0503a',
                relief='flat', padx=22, pady=10,
                command=root.destroy)
btn.pack()
# top-right corner of a 1920x1200 panel
root.geometry('+1800+24')

# Fade the badge out while the user is watching (no pointer movement for
# ~3s); any pointer activity brings it back.
def pointer():
    try:
        out = subprocess.run(['xdotool', 'getmouselocation'],
                             capture_output=True, text=True, timeout=2)
        return out.stdout.strip()
    except Exception:
        return ''

state = {'pos': pointer(), 'idle': 0, 'alpha': 1.0}

def watchdog():
    if not browser_alive():
        root.destroy()
        return
    p = pointer()
    if p != state['pos']:
        state['pos'] = p
        state['idle'] = 0
        if state['alpha'] < 1.0:
            state['alpha'] = min(1.0, state['alpha'] + 0.34)
            root.attributes('-alpha', state['alpha'])
    else:
        state['idle'] += 1
        if state['idle'] >= 6 and state['alpha'] > 0.06:
            state['alpha'] = max(0.06, state['alpha'] - 0.15)
            root.attributes('-alpha', state['alpha'])
    root.after(500, watchdog)

root.after(500, watchdog)
root.mainloop()

subprocess.run(['pkill', '-f', 'chrome.*xamedia-chrome'])
PYEOF
exit 0
